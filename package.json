{
  "name": "bangla-phonetic-ime",
  "version": "0.0.9",
  "description": "Terminal-only MVP for an Avro-like Bangla phonetic typing engine.",
  "type": "module",
  "bin": {
    "bangla-ime": "./bin/bangla-ime.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js --interactive",
    "test": "node --test",
    "evaluate": "node tools/evaluate.js",
    "benchmark": "node tools/benchmark.js",
    "regression": "node tools/regression-check.js",
    "validate:corpus": "node tools/validate-corpus.js",
    "validate:tson": "node tools/validate-tson.js",
    "rebuild": "node tools/rebuild-all.js",
    "lm:build": "node tools/build-language-model.js",
    "memory:report": "node tools/memory-report.js",
    "compatibility": "node tools/verify-avro-pdf-spec.js",
    "avro:verify": "node tools/verify-avro-pdf-spec.js",
    "avro:audit": "node tools/avro-rule-audit.js",
    "avro:compare": "node tools/compare-avro-spec-output.js",
    "ibus:status": "node tools/validate-ibus.js"
  },
  "keywords": [
    "bangla",
    "bengali",
    "phonetic",
    "avro",
    "cli"
  ],
  "license": "MPL-2.0"
}
