{
  "name": "bangla-phonetic-ime",
  "version": "0.0.5",
  "description": "Terminal-only MVP for an Avro-like Bangla phonetic typing engine.",
  "type": "module",
  "bin": {
    "bangla-ime": "./bin/bangla-ime.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node src/cli.js --interactive",
    "test": "node --test",
    "evaluate": "node tools/evaluate.js",
    "benchmark": "node tools/benchmark.js",
    "regression": "node tools/regression-check.js",
    "validate:corpus": "node tools/validate-corpus.js",
    "validate:tson": "node tools/validate-tson.js",
    "rebuild": "node tools/rebuild-all.js"
  },
  "keywords": [
    "bangla",
    "bengali",
    "phonetic",
    "avro",
    "cli"
